# Server-only credentials. REFLECT_LLM_* take precedence over existing LLM_* aliases.
ZHIHU_ACCESS_SECRET=
REFLECT_LLM_BASE_URL=https://api.deepseek.com
REFLECT_LLM_API_KEY=
REFLECT_LLM_MODEL=deepseek-v4-flash
REFLECT_DAILY_LIMIT=10
REFLECT_MAX_QUERIES=2
REFLECT_SEARCH_COUNT=5
REFLECT_LLM_TIMEOUT_MS=45000
REFLECT_DEADLINE_MS=60000

# Optional: connect a user's Zhihu favorites on the reflection page.
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_COOKIE_SECRET=
ZHIHU_OAUTH_REDIRECT_URI=
